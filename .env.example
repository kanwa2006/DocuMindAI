# ═══════════════════════════════════════════════════════════════════════════════
# DocuMindAI — Environment Configuration  (BACKEND)
#
# Copy to `backend/.env` and fill in your own values.  NEVER commit the filled-in
# file — `.env` is gitignored at the repo root and in backend/.gitignore.
# Frontend variables live in `frontend/.env.example` (they are PUBLIC — see the
# note at the bottom of this file).
#
# Loaded by: backend/app/core/config.py  →  pydantic-settings `Settings`
#            (reads $ENV_FILE, default `.env`, relative to the backend/ dir)
#
# Legend:  [REQUIRED] app will not boot without it
#          [SECRET]   never share, never commit, rotate if exposed
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                       # development | production
PROJECT_NAME=DocuMindAI
API_V1_STR=/api/v1
# [REQUIRED] Used for the CORS allow-list and the CSP connect-src header.
FRONTEND_URL=http://localhost:3000
# JSON array of allowed browser origins. Must include your deployed frontend.
CORS_ORIGINS=["http://localhost:3000"]

# ── Security ──────────────────────────────────────────────────────────────────
# [REQUIRED][SECRET] Generate each with:  openssl rand -hex 32
# Must be >= 32 bytes — shorter keys trigger an RFC 7518 InsecureKeyLength warning.
AUTH_SECRET_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32
CSRF_SECRET_KEY=replace_with_a_DIFFERENT_64_hex_char_secret
JWT_ALGORITHM=HS256                           # HS256 only — decoding is pinned to it
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database — Postgres + pgvector ───────────────────────────────────────────
# Option A (recommended): one full URL. When set it OVERRIDES every POSTGRES_* below.
# Supabase → Dashboard → Settings → Database → Connection string → URI.
# Use the TRANSACTION pooler (port 6543) so pgbouncer handles pooling.
# [SECRET] contains your DB password.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# Option B: individual fields, used only when DATABASE_URL is unset.
POSTGRES_SERVER=localhost                     # [REQUIRED]
POSTGRES_PORT=5432
POSTGRES_USER=postgres                        # [REQUIRED]
POSTGRES_PASSWORD=your_db_password            # [REQUIRED][SECRET]
POSTGRES_DB=documind                          # [REQUIRED]
#
# Local docker-compose fallback (note port 5433 — compose remaps it):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/documind

# ── Redis / Celery ───────────────────────────────────────────────────────────
# [REQUIRED][SECRET] Validated at startup: must start with redis:// or rediss://
# Upstash uses TLS, so its URL starts with rediss://
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:<password>@<host>.upstash.io:6379
#
# Local docker-compose fallback (note port 6380):
# REDIS_URL=redis://localhost:6380/0

# ── LLM — Google Gemini ──────────────────────────────────────────────────────
# [SECRET] Read from os.environ by GeminiKeyRotator (services/llm_key_rotation.py),
# NOT from the Settings object. At least _1 is needed, or the app silently serves
# mock answers via DummyLLMProvider. Add _2, _3, ... to enable key rotation.
GEMINI_API_KEY_1=AIza_your_gemini_api_key_here
# GEMINI_API_KEY_2=AIza_optional_second_key_for_rotation
# GEMINI_API_KEYS=key1,key2                   # legacy comma-separated form
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.8
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_CONTINUATION_ROUNDS=2                  # INERT — declared, never read
LLM_TIMEOUT_SECONDS=120                       # cap on non-streaming LLM calls

# ── Retrieval / RAG tuning ───────────────────────────────────────────────────
VECTOR_BACKEND=pgvector                       # pgvector | faiss (dev NumPy scan) | qdrant
# QDRANT_HOST=localhost                       # only when VECTOR_BACKEND=qdrant
# QDRANT_PORT=6333
# INERT: declared in Settings but never read. Per-workspace top_k comes from
# WORKSPACE_RETRIEVAL_CONFIG in config.py instead. Kept for compatibility.
TOP_K_RESULTS=20
MAX_CHUNKS_PER_QUERY=12                       # INERT — declared, never read
GROUNDING_TOKEN_BUDGET=6000
CHUNK_SIZE=1800
CHUNK_OVERLAP=300
RERANKER_PROVIDER=local                       # only "local" has a real implementation
VECTOR_ISOLATION_MODE=user                    # user | organization
ENABLE_ORG_ISOLATION=false                    # INERT — declared, never read

# ── Ingestion / OCR ──────────────────────────────────────────────────────────
OCR_SCANNED_ENABLED=true                      # route scanned pages via PaddleOCR/Docling
OCR_CONFIDENCE_THRESHOLD=0.80                 # 0.0–1.0 (validated at startup, but never read at runtime)
MAX_UPLOAD_MB=200                             # 1–1000 (validated)
LARGE_DOC_PAGE_THRESHOLD=200                  # INERT — declared, never read

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local                        # local | s3 (validated)
STORAGE_PATH=./storage
# Required ONLY when STORAGE_PROVIDER=s3 (enforced at startup):
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=your_access_key           # [SECRET]
# AWS_SECRET_ACCESS_KEY=your_secret_key       # [SECRET]

# ── Cost guard — per-workspace daily token budgets ───────────────────────────
TOKEN_LIMIT_GENERAL=50000
TOKEN_LIMIT_LEGAL=80000
TOKEN_LIMIT_FINANCE=80000
TOKEN_LIMIT_HR=60000
TOKEN_LIMIT_TEACHER=40000
TOKEN_LIMIT_STUDENT=40000
TOKEN_LIMIT_RESEARCH=60000
TOKEN_COST_PER_MTK=3.0                        # INERT — declared, never read
SLOW_QUERY_THRESHOLD_MS=8000                  # INERT — declared, never read

# ── Billing — Razorpay ───────────────────────────────────────────────────────
# Read via os.getenv in api/v1/endpoints/billing.py, NOT via Settings.
RAZORPAY_ENABLED=false                        # true enables real checkout
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx       # rzp_test_ prefix = sandbox
# RAZORPAY_KEY_SECRET=your_razorpay_secret    # [SECRET]
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret # [SECRET]

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Primary: SendGrid. SMTP_USER is the literal string "apikey".
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key_here   # [SECRET]
EMAIL_FROM=noreply@yourdomain.com
EMAILS_FROM_NAME=DocuMindAI
EMAILS_FROM_ADDRESS=noreply@yourdomain.com
ADMIN_EMAIL=you@example.com
# Fallback: Brevo
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your_brevo_login_email
# BREVO_SMTP_PASSWORD=your_brevo_smtp_key     # [SECRET]

# ── SMS — Twilio (optional, phone OTP) ───────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # [SECRET]
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # [SECRET]
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>   # [SECRET]
# WARNING — all three below are currently INERT (declared but never read):
#   core/logging.py keys off ENVIRONMENT, not LOG_LEVEL.
#   core/telemetry.py ignores OTEL_ENABLED / PROMETHEUS_ENABLED and always
#   installs a ConsoleSpanExporter, so every request logs a JSON span.
# See docs/audit/PROJECT_AUDIT_AND_DEPLOYMENT.md §10 for the proposed fix.
LOG_LEVEL=INFO                                # INERT — DEBUG | INFO | WARNING | ERROR
OTEL_ENABLED=false                            # INERT — tracing is always on regardless
PROMETHEUS_ENABLED=false                      # INERT

# ── Eval automation (optional) ───────────────────────────────────────────────
# Both INERT — declared in Settings but never read by any module.
# DEPLOY_EVAL_SECRET=random_shared_secret                              # [SECRET]
# EVAL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz  # [SECRET]

# ═══════════════════════════════════════════════════════════════════════════════
# KNOWN GAP — TAVILY_API_KEY
# services/deep_research_agent.py reads `settings.TAVILY_API_KEY`, but that field
# does not exist in core/config.py and `tavily` is not in requirements.txt.
# Setting it here has NO effect today: web-search-augmented research silently
# no-ops (the call is wrapped in try/except → logs a warning → returns None).
# Left undeclared on purpose, so this file documents reality rather than intent.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Frontend variables — set these in frontend/.env.local, NOT here ──────────
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time and is fully
# public. Never put a secret behind a NEXT_PUBLIC_ prefix.
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1   # MUST include /api/v1
#   NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
#   NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
