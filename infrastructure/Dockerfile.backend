# Multi-stage Docker build for DocuMindAI backend.
#
# BUILD CONTEXT: the repository ROOT (not backend/).
#   docker build -f infrastructure/Dockerfile.backend .
# Docker forbids `COPY ../` — a COPY source can never escape the build context —
# so every path below is repo-root-relative.  docker-compose.yml and render.yaml
# both pass the repo root as the context to match.
#
# REQUIREMENTS_FILE (build-time ARG, default: requirements.txt)
#   Pass --build-arg REQUIREMENTS_FILE=requirements-deploy.txt for free-tier
#   hosts (Render Free) that cannot fit paddlepaddle + docling (multi-GB).
#   See backend/requirements-deploy.txt for the exact list of what is dropped.
ARG REQUIREMENTS_FILE=requirements-deploy.txt

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder
# Re-declare ARG inside the stage (Docker ARG scoping rule — global ARG does
# not propagate into FROM stages automatically).
ARG REQUIREMENTS_FILE=requirements-deploy.txt
WORKDIR /app
COPY backend/requirements.txt backend/requirements-deploy.txt ./
RUN apt-get update && apt-get install -y build-essential libpq-dev && rm -rf /var/lib/apt/lists/*
# Wheel the full dependency closure for the chosen requirements file.
# --no-deps would skip transitive dependencies and produce an unsatisfiable
# install in stage 2; omitting it lets pip resolve once, correctly.
RUN pip wheel --no-cache-dir --wheel-dir /app/wheels -r ${REQUIREMENTS_FILE}

# ── Stage 2: Production Image ─────────────────────────────────────────────────
FROM python:3.11-slim
ARG REQUIREMENTS_FILE=requirements-deploy.txt
WORKDIR /app

# Runtime system dependencies:
#   libpq-dev  — psycopg2 / asyncpg
#   libgl1     — OpenCV (pulled in by paddlepaddle when full deps are used)
#   curl       — healthcheck probe
RUN apt-get update && \
    apt-get install -y libpq-dev libgl1 libglib2.0-0 tesseract-ocr poppler-utils curl && \
    rm -rf /var/lib/apt/lists/*

# Install from pre-built wheels — hermetic, no PyPI network at install time.
COPY --from=builder /app/wheels /wheels
COPY backend/requirements.txt backend/requirements-deploy.txt ./
RUN pip install --no-cache --no-index --find-links=/wheels -r ${REQUIREMENTS_FILE}

# Copy application code.  Must include alembic/ and alembic.ini — the
# deployment start command runs `alembic upgrade head` before uvicorn.
COPY backend /app
RUN sed -i 's/\r$//' /app/scripts/*.sh && chmod +x /app/scripts/*.sh

ENV PYTHONUNBUFFERED=1

# Bind to $PORT when the platform injects one (Render/Railway), else 8000.
EXPOSE 8000
CMD ["/app/scripts/start-deploy.sh"]
