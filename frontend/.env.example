# DocuMindAI — Frontend environment
# Copy to `.env.local` (gitignored) and fill in.
#
# WARNING: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle at
# BUILD time and is visible to anyone who opens the site. Never put a secret
# behind a NEXT_PUBLIC_ prefix. Changing one requires a REBUILD, not a restart.

# [REQUIRED] Backend base URL. MUST include the /api/v1 suffix — lib/api.ts
# prepends only the endpoint path (endpoints start with "/" and omit /api/v1).
# Read at: src/lib/api.ts:45
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional — PostHog product analytics. Silently skipped when unset.
# Read at: src/lib/analytics.ts:4
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key

# Optional — Sentry browser error reporting. Skipped when unset.
# Read at: sentry.client.config.ts:4
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# NOTE: NEXT_PUBLIC_WS_URL was present in the previous version of this template
# but is not read anywhere in the codebase. Removed deliberately.
